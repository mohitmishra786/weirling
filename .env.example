# Application
# production is the default and the only mode for an exposed instance.
# Local development uses docker-compose.dev.yml, which sets APP_ENV=development.
APP_ENV=production
# Log line format: json (default, one object per line, no personal data) or text
# (the older human-readable format for local tinkering).
LOG_FORMAT=json
# Required. Run ./scripts/init_env.sh to generate SECRET_KEY, REFRESH_SECRET_KEY,
# METRICS_TOKEN and SECRETS_ENCRYPTION_KEY; the app refuses to start without a strong key.
SECRET_KEY=
# selfhost (default): no plans or quotas. hosted: per-plan quotas apply (#172);
# defaults in backend/app/config.py DEFAULT_PLAN_QUOTAS. Override per plan with
# JSON, e.g. HOSTED_PLAN_QUOTAS={"pro": {"sources": 3000}}; per account:
# scripts/set_quota.py.
DEPLOYMENT_MODE=selfhost
# Database connections (backend/app/database.py). auto: the API pools, Celery
# workers and beat don't (pooled asyncpg connections leak across their per-task
# event loops). Keep DB_POOL_SIZE + DB_MAX_OVERFLOW per API replica well under
# your Postgres max_connections (often 100 on managed plans).
DB_POOL=auto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Hosted has no free tier (#341): after the trial an unpaid account is paused,
# then deleted this many days later (0 = never), after a reminder sent
# HOSTED_DELETE_REMINDER_DAYS before.
# First-party product metrics (#131): auto = on for hosted, off for self-host;
# on/off force it. Events stay on this server; owner dashboard at /admin/metrics.
PRODUCT_METRICS=auto
HOSTED_PAUSED_DELETE_DAYS=30
# Priority fetching for Pro (#246): a feed with a Pro reader is checked at least
# this often after a clean poll, and goes first in each polling run.
HOSTED_PRO_MAX_POLL_MINUTES=60
HOSTED_DELETE_REMINDER_DAYS=7
# Error tracking (opt-in). Leave blank to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Token gating the aggregate /metrics/* endpoints (X-Metrics-Token header).
# Required outside development (generated by scripts/init_env.sh).
METRICS_TOKEN=
# Optional distinct signing key for refresh tokens (falls back to SECRET_KEY).
REFRESH_SECRET_KEY=
# Encrypts secrets saved from the browser (setup screen LLM key / SMTP password,
# per-user LLM keys). Generated by scripts/init_env.sh. Changing it makes those
# stored secrets unreadable (re-enter them).
SECRETS_ENCRYPTION_KEY=
# Who may create accounts: closed (only the first account; default on selfhost),
# invite (codes below), open (default on hosted).
REGISTRATION_MODE=
REGISTRATION_INVITE_CODES=
# Email verification (#175): auto (required on hosted, off on selfhost) | required | off.
# Unverified accounts get no email except the verification link and accept no newsletters.
EMAIL_VERIFICATION=auto
# Hosted signup limit per email domain per hour (big providers get 20x).
SIGNUP_PER_DOMAIN_PER_HOUR=10
# Hosted billing through a merchant of record (#173) or gateway (#342); leave empty on selfhost.
# BILLING_PROVIDER=lemonsqueezy|paddle|razorpay, webhook at /api/v1/billing/webhook/<provider>.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# Razorpay gateway (#342); operator handles GST/taxes (not a merchant of record).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
# Paddle: checkout and portal sessions. Both: cancel on account deletion (#221).
BILLING_API_KEY=
BILLING_SANDBOX=false
# Plans on sale (#172): Lemon Squeezy checkout links or Paddle price ids.
# A plan with no link isn't offered.
BILLING_CHECKOUT_READER_MONTHLY=
BILLING_CHECKOUT_READER_YEARLY=
BILLING_CHECKOUT_PRO_MONTHLY=
BILLING_CHECKOUT_PRO_YEARLY=
# Price/variant ids that grant each tier (comma-separated).
BILLING_READER_PRICE_IDS=
BILLING_PRO_PRICE_IDS=
BILLING_TEAM_PRICE_IDS=
BILLING_TRIAL_DAYS=30
# Trial emails (#235): "ending soon" goes this many days before the end.
TRIAL_ENDING_NOTICE_DAYS=5
# YouTube channel feeds (#240): errors are treated as a platform outage; a channel
# is only considered gone after this many days of continuous failure.
YOUTUBE_DEAD_AFTER_DAYS=30
# Gentle win-back (#238): days since the last opened digest for the three
# nudges (top-3 digest, "pause or weekly?", final note), and the minimum gap.
REENGAGEMENT_STAGE_DAYS=3,10,30
REENGAGEMENT_MIN_GAP_DAYS=3
# Also switch digest emails off at the final nudge (default: only the nudges stop).
REENGAGEMENT_PAUSE_DIGEST_AT_FINAL=false
# Web Push digest alerts (#266), opt-in per device. Off unless all three are set.
# Generate keys: cd backend && python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Academic discount (#250): Paddle discount id (dsc_...) or Lemon Squeezy code.
# Applied automatically for verified emails on BILLING_ACADEMIC_DOMAINS.
BILLING_ACADEMIC_DISCOUNT=
# BILLING_ACADEMIC_DOMAINS=.edu,.ac.uk,.edu.au,...   (default: common academic suffixes)
# Digest SLO (#239): delivered within this many seconds of being due counts as on time.
DIGEST_ON_TIME_SECONDS=900
# Instance health banner for the owner (#234): worker heartbeat age (minutes),
# no-new-items window (hours), and queue backlog that raise a warning.
HEALTH_WORKER_STALE_MINUTES=30
HEALTH_INGEST_STALE_HOURS=6
HEALTH_QUEUE_BACKLOG=1000
# Prometheus /metrics (#170): your LLM price per million tokens (USD) for the
# cost series; 0 leaves it out.
LLM_COST_PER_MILLION_TOKENS=0
# Grafana admin password for `--profile monitoring` (#170). Change it.
GRAFANA_ADMIN_PASSWORD=admin
# Operator alerts (#171): ingest stall, queue lag, 5xx, disk, backups, LLM
# errors, stopped workers. Send to an ntfy topic and/or an email; neither = log only.
ALERT_NTFY_URL=
ALERT_EMAIL=
ALERT_REPEAT_HOURS=12
ALERT_INGEST_STALL_HOURS=2
ALERT_5XX_RATE=0.05
ALERT_LLM_ERROR_RATE=0.5
ALERT_DISK_PATHS=/
ALERT_DISK_PERCENT=80
ALERT_BACKUP_MAX_AGE_HOURS=36
# Raw reading telemetry retention in days (#224); 0 keeps it forever.
TELEMETRY_RAW_RETENTION_DAYS=90
# Reader full text (#177): auto (hosted shows feed-syndicated text only; selfhost all) | all | feed_only
READER_FULL_TEXT=auto
# Takedown and grievance contact email displayed on /contact (empty = hidden) (#183)
GRIEVANCE_CONTACT_EMAIL=
# Version slug of Terms of Service for signup consent audit trail (#181)
TERMS_VERSION=2026-07-21
# Public zero-login read-only demo mode (#229)
DEMO_MODE=false
# Hosted abuse controls (#169); 0 disables a limit.
HOSTED_FETCH_BUDGET_PER_HOUR=300
HOSTED_HOST_POLLS_PER_HOUR=120
HOSTED_MAX_SOURCES_PER_HOST=10
HOSTED_INBOUND_PER_DAY=100
HOSTED_INBOUND_MB_PER_DAY=25
# Any instance: larger inbound newsletters are dropped.
INBOUND_MAX_MESSAGE_BYTES=2000000
# Browser sessions use httpOnly cookies. The web app and API must be on the
# same site (e.g. app.example.com + api.example.com). Leave empty for a
# host-only cookie; set ".example.com" if they are on different subdomains.
COOKIE_DOMAIN=
# auto: Secure cookies only over HTTPS (so LAN http:// installs can sign in).
COOKIE_SECURE=auto
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAGIC_LINK_EXPIRE_MINUTES=20
# Compose publishes the UI on 3001. `npm run dev` uses 3000; set this to match
# the origin the browser actually uses, or add the other one to CORS_EXTRA_ORIGINS.
FRONTEND_URL=http://localhost:3001

# Database
# Migrations run on backend start; set false to run `python -m app.migrate` yourself.
AUTO_MIGRATE=true
DATABASE_URL=postgresql+asyncpg://readprism:readprism@db:5432/readprism
DATABASE_SYNC_URL=postgresql+psycopg2://readprism:readprism@db:5432/readprism

# Redis
REDIS_URL=redis://redis:6379/0

# LLM — any OpenAI-compatible endpoint. Groq is the default base URL.
# Model ids are configuration. Do not put a model id in code.
# Groq free/developer tier retired llama-3.3-70b-versatile and llama-3.1-8b-instant
# on 2026-08-16. If those names are still set, the process rewrites them and warns.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Hosted: providers a reader may use with their own key (#255), comma-separated.
BYOK_ALLOWED_BASE_URLS=https://api.groq.com/openai/v1,https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.together.xyz/v1,https://api.fireworks.ai/inference/v1,https://api.deepinfra.com/v1/openai
# Per-task models (#225); empty = summaries and topics on FAST, synthesis and
# interest expansion on PRIMARY. Ollama: docs/DEPLOYMENT.md.
LLM_MODEL_SUMMARY=
LLM_MODEL_TOPICS=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_INTERESTS=
# gpt-oss reasons before answering; "auto" sends reasoning_effort=low to gpt-oss
# models only (summaries otherwise run out of tokens). "" never sends the field.
LLM_REASONING_EFFORT=auto
# Don't wait longer than this for a provider's Retry-After (e.g. a daily cap);
# the summary stays extractive instead of stalling the worker queue.
LLM_MAX_RETRY_WAIT_SECONDS=30
# Token-bucket size. Size this to the provider's per-minute caps.
LLM_TPM_LIMIT=6000
LLM_RPM_LIMIT=30
LLM_TIMEOUT_SECONDS=30
# lazy (default): extractive summaries at ingest; the model only for items placed in a
# digest or opened in the reader. all: the model for every ingested item.
LLM_SUMMARIZE=lazy
DIGEST_LLM_SUMMARY_LIMIT=20
# Deprecated legacy names, still read if LLM_API_KEY / LLM_MODEL_* are unset.
# GROQ_* is deprecated since #265 and will be removed in v0.3 — set
# LLM_API_KEY / LLM_MODEL_PRIMARY / LLM_MODEL_FAST instead.
GROQ_API_KEY=
GROQ_SUMMARIZATION_MODEL=
GROQ_FAST_MODEL=

# Optional second provider. All three must be set or the fallback is skipped.
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Extra browser origins, comma-separated, added to FRONTEND_URL.
# Production allows only this list. Development also allows localhost:3000 and :3001.
CORS_EXTRA_ORIGINS=
# Posts to /feedback/interaction per IP per minute.
RATE_LIMIT_FEEDBACK_PER_MINUTE=60
# Reject feed/OPML bodies and outline counts above these (XML bombs, huge imports).
XML_MAX_BYTES=2000000
OPML_MAX_OUTLINES=5000

# Embeddings (local sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# ADR 0004 (#244): Set true with EMBEDDING_MODEL=bge-small-en-v1.5 to switch models.
EMBEDDING_CUTOVER_ENABLED=false
# Online re-embed batch size (default 200) and rate-limit pause in seconds (#244).
# EMBEDDING_REEMBED_BATCH=200
# EMBEDDING_REEMBED_PAUSE_SECONDS=0.0
RANKING_EXPLORATION_ENABLED=false
RANKER_VERSION=2

# Email delivery over SMTP with STARTTLS (any provider; ZOHO_* names still work).
# Spacemail: mail.spacemail.com, port 587, the mailbox address and password.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_USER=hello@weirling.com
SMTP_PASSWORD=
FROM_EMAIL=hello@weirling.com
# Externally-reachable API base URL — builds one-click unsubscribe links in
# digest emails. Set to your public API domain in production.
PUBLIC_API_URL=http://localhost:8000
# Physical mailing address for the email footer (CAN-SPAM). Set for bulk sends.
EMAIL_PHYSICAL_ADDRESS=

# Newsletter ingestion
NEWSLETTER_INBOX_DOMAIN=inbox.weirling.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Mailgun *Webhook Signing Key* (Settings -> API Security), NOT the API key.
# Required to authenticate the /newsletter/inbound webhook. If unset, the
# webhook is fail-closed outside development (rejects all posts).
MAILGUN_WEBHOOK_SIGNING_KEY=
NEWSLETTER_WEBHOOK_MAX_AGE_SECONDS=900

# Scraping
BROWSERLESS_URL=http://browserless:3000
# Optional. When set, discovery can route closed platforms (for example X)
# through your RSSHub. Leave empty to make no RSSHub calls.
RSSHUB_BASE_URL=
SCRAPER_MAX_CONCURRENCY=5
# SSRF protection: block private/loopback/link-local/metadata IPs on server-side
# fetches. Keep true for any hosted deployment. Self-hosters ingesting LAN feeds
# on a single-tenant box may set false.
SSRF_PROTECTION_ENABLED=true
# Scraping posture (honest by default): identify as the Weirling bot and back
# off on explicit blocks instead of circumventing them. Set false to accept the
# 2026 anti-circumvention (§1201) risk of browser-impersonation + bypass.
SCRAPER_IDENTIFY_AS_BOT=true
SCRAPER_RESPECT_BLOCKS=true
CONTENT_FULL_TEXT_RETENTION_DAYS=90
CONTENT_PER_SOURCE_CAP=500
SOURCE_BACKFILL_LIMIT=20
DIGEST_PER_SOURCE_CAP=3
# A digest with fewer items than this is still built for in-app but no email
# is sent ("nothing worth reading" skip, UX-03).
DIGEST_MIN_ITEMS=3
# Comma-separated hosts the scraper refuses even when robots.txt allows them.
SCRAPER_DENY_DOMAINS=
ROBOTS_FAIL_OPEN=false
# Inbound newsletter providers. Empty secrets fail closed outside development.
POSTMARK_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=
NEWSLETTER_DOMAIN=newsletters.weirling.local

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Rate limiting (Redis-backed) for auth endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

# Feature flags
COLD_START_COLLABORATIVE_ENABLED=true
SERENDIPITY_DEFAULT_PERCENTAGE=15
DIGEST_DEFAULT_ITEMS=12

# Self-host only: let the Miniflux/FreshRSS sidecar import reach its server over
# plain http on a private address (e.g. http://192.168.1.10:8080). Ignored on hosted.
SIDECAR_ALLOW_PRIVATE_HTTP=false

# Beta measurement: team-draft interleave PRS with newest-first in every digest and
# report the PRS win rate at GET /api/v1/metrics/interleaving (operator token).
RANKING_INTERLEAVING=false
