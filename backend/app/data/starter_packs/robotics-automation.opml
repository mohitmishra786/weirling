      <outline text="The Robot Report" title="The Robot Report" type="rss" xmlUrl="https://www.therobotreport.com/feed/" htmlUrl="https://www.therobotreport.com/"/>
      <outline text="Robohub" title="Robohub" type="rss" xmlUrl="https://robohub.org/feed/" htmlUrl="https://robohub.org/"/>
      <outline text="Robotics Business Review" title="Robotics Business Review" type="rss" xmlUrl="https://www.roboticsbusinessreview.com/feed/" htmlUrl="https://www.roboticsbusinessreview.com/"/>
      <outline text="ROS Discourse" title="ROS Discourse" type="rss" xmlUrl="https://discourse.ros.org/latest.rss" htmlUrl="https://discourse.ros.org/"/>
      <outline text="TechCrunch: Robotics" title="TechCrunch: Robotics" type="rss" xmlUrl="https://techcrunch.com/category/robotics/feed/" htmlUrl="https://techcrunch.com/category/robotics/"/>
      <outline text="MIT News: Robotics" title="MIT News: Robotics" type="rss" xmlUrl="https://news.mit.edu/topic/mitrobotics-rss.xml" htmlUrl="https://news.mit.edu/topic/robotics"/>
      <outline text="Weekly Robotics" title="Weekly Robotics" type="rss" xmlUrl="https://www.weeklyrobotics.com/feed.xml" htmlUrl="https://www.weeklyrobotics.com/"/>
      <outline text="Automatic Addison" title="Automatic Addison" type="rss" xmlUrl="https://automaticaddison.com/feed/" htmlUrl="https://automaticaddison.com/"/>
      <outline text="Open Robotics" title="Open Robotics" type="rss" xmlUrl="https://www.openrobotics.org/blog?format=rss" htmlUrl="https://www.openrobotics.org/blog"/>
      <outline text="Robotiq Blog" title="Robotiq Blog" type="rss" xmlUrl="https://blog.robotiq.com/rss.xml" htmlUrl="https://blog.robotiq.com/"/>
    </outline>
  </body>
</opml>
