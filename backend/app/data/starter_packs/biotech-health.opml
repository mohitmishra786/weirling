      <outline text="Nature Biotechnology" title="Nature Biotechnology" type="rss" xmlUrl="https://www.nature.com/nbt.rss" htmlUrl="https://www.nature.com/nbt/"/>
      <outline text="Science Translational Medicine" title="Science Translational Medicine" type="rss" xmlUrl="https://www.science.org/action/showFeed?jc=stm&amp;type=etoc&amp;feed=rss" htmlUrl="https://www.science.org/journal/stm"/>
      <outline text="Genetic Engineering News" title="Genetic Engineering News" type="rss" xmlUrl="https://www.genengnews.com/feed/" htmlUrl="https://www.genengnews.com/"/>
      <outline text="Bio-IT World" title="Bio-IT World" type="rss" xmlUrl="https://www.bio-itworld.com/rss" htmlUrl="https://www.bio-itworld.com/"/>
      <outline text="CDC Newsroom" title="CDC Newsroom" type="rss" xmlUrl="https://tools.cdc.gov/api/v2/resources/media/132608.rss" htmlUrl="https://www.cdc.gov/media/"/>
      <outline text="KevinMD" title="KevinMD" type="rss" xmlUrl="https://www.kevinmd.com/feed/" htmlUrl="https://www.kevinmd.com/"/>
      <outline text="Nature Medicine" title="Nature Medicine" type="rss" xmlUrl="https://www.nature.com/nm.rss" htmlUrl="https://www.nature.com/nm/"/>
    </outline>
  </body>
</opml>
