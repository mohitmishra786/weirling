<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Science News: Weirling starter pack</title>
    <!-- Scope: Science journalism across fields. Each feed belongs to one pack only. -->
  </head>
  <body>
    <outline text="Science News" title="Science News">
      <outline text="Quanta Magazine" title="Quanta Magazine" type="rss" xmlUrl="https://api.quantamagazine.org/feed/" htmlUrl="https://www.quantamagazine.org/"/>
      <outline text="Science News" title="Science News" type="rss" xmlUrl="https://www.sciencenews.org/feed" htmlUrl="https://www.sciencenews.org/"/>
      <outline text="Science (news)" title="Science (news)" type="rss" xmlUrl="https://www.science.org/rss/news_current.xml" htmlUrl="https://www.science.org/news"/>
      <outline text="Ars Technica: Science" title="Ars Technica: Science" type="rss" xmlUrl="https://feeds.arstechnica.com/arstechnica/science" htmlUrl="https://arstechnica.com/science/"/>
      <outline text="Nautilus" title="Nautilus" type="rss" xmlUrl="https://nautil.us/feed/" htmlUrl="https://nautil.us/"/>
      <outline text="Knowable Magazine" title="Knowable Magazine" type="rss" xmlUrl="https://knowablemagazine.org/rss" htmlUrl="https://knowablemagazine.org/"/>
      <outline text="Phys.org" title="Phys.org" type="rss" xmlUrl="https://phys.org/rss-feed/" htmlUrl="https://phys.org/"/>
      <outline text="ScienceDaily" title="ScienceDaily" type="rss" xmlUrl="https://www.sciencedaily.com/rss/top/science.xml" htmlUrl="https://www.sciencedaily.com/"/>
      <outline text="RealClearScience" title="RealClearScience" type="rss" xmlUrl="https://www.realclearscience.com/index.xml" htmlUrl="https://www.realclearscience.com/"/>
      <outline text="Scientific American" title="Scientific American" type="rss" xmlUrl="https://www.scientificamerican.com/platform/syndication/rss/" htmlUrl="https://www.scientificamerican.com/"/>
    </outline>
  </body>
</opml>
