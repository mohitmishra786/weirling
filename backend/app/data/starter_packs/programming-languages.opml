      <outline text="Go Blog" title="Go Blog" type="rss" xmlUrl="https://go.dev/blog/feed.atom" htmlUrl="https://go.dev/blog/"/>
      <outline text="TypeScript Blog" title="TypeScript Blog" type="rss" xmlUrl="https://devblogs.microsoft.com/typescript/feed/" htmlUrl="https://devblogs.microsoft.com/typescript/"/>
      <outline text="C++ Team Blog" title="C++ Team Blog" type="rss" xmlUrl="https://devblogs.microsoft.com/cppblog/feed/" htmlUrl="https://devblogs.microsoft.com/cppblog/"/>
      <outline text="Python Software Foundation News" title="Python Software Foundation News" type="rss" xmlUrl="https://pyfound.blogspot.com/feeds/posts/default" htmlUrl="https://pyfound.blogspot.com/"/>
      <outline text="Real Python" title="Real Python" type="rss" xmlUrl="https://realpython.com/atom.xml" htmlUrl="https://realpython.com/"/>
      <outline text="Inside Java" title="Inside Java" type="rss" xmlUrl="https://inside.java/feed.xml" htmlUrl="https://inside.java/"/>
      <outline text="Julia Blog" title="Julia Blog" type="rss" xmlUrl="https://julialang.org/feed.xml" htmlUrl="https://julialang.org/blog/"/>
      <outline text="Zig News" title="Zig News" type="rss" xmlUrl="https://ziglang.org/news/index.xml" htmlUrl="https://ziglang.org/news/"/>
      <outline text="Eli Bendersky" title="Eli Bendersky" type="rss" xmlUrl="https://eli.thegreenplace.net/feeds/all.atom.xml" htmlUrl="https://eli.thegreenplace.net/"/>
      <outline text="fasterthanlime" title="fasterthanlime" type="rss" xmlUrl="https://fasterthanli.me/index.xml" htmlUrl="https://fasterthanli.me/"/>
    </outline>
  </body>
