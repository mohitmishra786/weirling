      <outline text="Smashing Magazine" title="Smashing Magazine" type="rss" xmlUrl="https://www.smashingmagazine.com/feed/" htmlUrl="https://www.smashingmagazine.com/"/>
      <outline text="CSS-Tricks" title="CSS-Tricks" type="rss" xmlUrl="https://css-tricks.com/feed/" htmlUrl="https://css-tricks.com/"/>
      <outline text="Josh W. Comeau" title="Josh W. Comeau" type="rss" xmlUrl="https://www.joshwcomeau.com/rss.xml" htmlUrl="https://www.joshwcomeau.com/"/>
      <outline text="Jake Archibald" title="Jake Archibald" type="rss" xmlUrl="https://jakearchibald.com/posts.rss" htmlUrl="https://jakearchibald.com/"/>
      <outline text="Addy Osmani" title="Addy Osmani" type="rss" xmlUrl="https://addyosmani.com/feed.xml" htmlUrl="https://addyosmani.com/blog/"/>
      <outline text="Kent C. Dodds" title="Kent C. Dodds" type="rss" xmlUrl="https://kentcdodds.com/rss.xml" htmlUrl="https://kentcdodds.com/blog"/>
      <outline text="React Blog" title="React Blog" type="rss" xmlUrl="https://react.dev/rss.xml" htmlUrl="https://react.dev/blog"/>
      <outline text="Svelte Blog" title="Svelte Blog" type="rss" xmlUrl="https://svelte.dev/blog/rss.xml" htmlUrl="https://svelte.dev/blog"/>
      <outline text="freeCodeCamp News" title="freeCodeCamp News" type="rss" xmlUrl="https://www.freecodecamp.org/news/rss/" htmlUrl="https://www.freecodecamp.org/news/"/>
    </outline>
  </body>
</opml>
